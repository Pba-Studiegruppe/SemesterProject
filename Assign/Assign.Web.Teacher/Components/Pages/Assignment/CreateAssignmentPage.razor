@page "/assignments/create"
@rendermode InteractiveServer
@using Assign.Web.Teacher.Models.Assignment
@using Assign.Web.Teacher.Models.Exercise
@using Assign.Web.Teacher.Services.ApiClients
@using Assign_Frontend.Services
@using Microsoft.JSInterop
@using Assign.Web.Teacher.Models.AssignmentSet
@inject AssignmentSetApiClient AssignmentSetApi
@inject AssignmentApiClient AssignmentApi
@inject ExerciseApiClient ExerciseApi
@inject IJSRuntime JS

<PageTitle>Create Assignment</PageTitle>

<nav class="text-sm text-gray-500 mb-4">
    <a href="/" class="hover:text-gray-700">Dashboard</a>
    <span class="mx-1">/</span>
    <a href="/assignment-sets" class="hover:text-gray-700">Assignment Sets</a>
    <span class="mx-1">/</span>
    @if (_parentSet is not null)
    {
        <a href="/assignment-sets/@_parentSet.Id" class="hover:text-gray-700">@_parentSet.Title</a>            
    }
    <span class="mx-1">/</span>
</nav>

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <i class="bi bi-journal-plus fs-2 text-primary"></i>
        <div>
            <h1 class="h3 mb-0">Create Assignment</h1>
            <p class="text-muted mb-0">Pick exercises, tailor the questions, set the points</p>
        </div>
    </div>

    @if (_parentSet is not null && _parentSet.IsPublished)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-lock-fill"></i>
            <div>
                <strong>@_parentSet.Title</strong> is already published — you can't add more assignments to it.
                <a href="/assignment-sets/@_parentSet.Id" class="ms-2">Back to set</a>
            </div>
        </div>
    }
    else if (_parentSet is not null)
    {
        <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-folder-fill"></i>
            <div>
                <strong>Creating in:</strong> @(string.IsNullOrWhiteSpace(_parentSet.Title) ? "(Untitled set)" : _parentSet.Title)
                <a href="/assignment-sets/@_parentSet.Id" class="ms-2 small">View set</a>
            </div>
        </div>
    }
    else if (SetId is not null && SetId != Guid.Empty)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-exclamation-triangle"></i>
            <div>
                The assignment set you specified couldn't be loaded. The assignment will be created standalone.
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Left column: details + preview/selected -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0">Assignment Details</h5></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input id="title" class="form-control"
                               value="@_builder.Title"
                               @onchange="HandleTitleChanged"
                               placeholder="e.g., Math Homework — Week 5" />
                    </div>
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible" role="alert">
                            @_errorMessage
                            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                        </div>
                    }

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="description" class="form-control" rows="3"
                                  value="@_builder.Description"
                                  @onchange="HandleDescriptionChanged"
                                  placeholder="A short description of this assignment"></textarea>
                    </div>
                    <button class="btn btn-success w-100"
                            disabled="@(IsCreated || _isBusy || string.IsNullOrWhiteSpace(_builder.Title))"
                            @onclick="HandleCreateAssignment">
                        @if (IsCreated)
                        {
                            <i class="bi bi-check-lg me-2"></i> <text>Assignment Created</text>
                        }
                        else
                        {
                            <i class="bi bi-plus-circle me-2"></i> <text>Create Assignment</text>
                        }
                    </button>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0">Preview</h5>
                    <span class="badge bg-primary fs-6">@_builder.TotalPoints pts</span>
                </div>
                <div class="card-body">
                    <SelectedExercisesList Exercises="_builder.Exercises"
                                           OnRemoveExercise="HandleRemoveExercise"
                                           OnRemoveQuestion="HandleRemoveQuestion"
                                           OnSetQuestionPoints="HandleSetQuestionPoints" />

                    <hr />

                    <button class="btn btn-primary w-100"
                            disabled="@(!IsCreated || _builder.Exercises.Count == 0 || _isBusy)"
                            @onclick="HandleGeneratePdf">
                        <i class="bi bi-file-earmark-pdf me-2"></i>Generate PDF
                    </button>
                </div>
            </div>
        </div>

        <!-- Right column: exercise catalog -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Exercise Catalog</h5>
                    <small class="text-muted">Search and add exercises to your assignment</small>
                </div>
                <div class="card-body">
                    <ExerciseCatalog Catalog="_catalog"
                                     OnAddExercise="HandleAddExercise"
                                     OnPreviewExercise="HandlePreviewExercise" />
                </div>
            </div>
        </div>
    </div>
</div>

<ExercisePreviewModal Preview="_currentPreview"
                      IsOpen="_isPreviewOpen"
                      OnClose="ClosePreview" />

@code {
    private AssignmentBuilderModel _builder = new();
    private ExerciseCatalogModel _catalog = new();
    private ExercisePreviewModel? _currentPreview;
    private bool _isPreviewOpen;
    private bool _isBusy;
    private string? _errorMessage;
    [SupplyParameterFromQuery(Name = "setId")]
    public Guid? SetId { get; set; }

    private AssignmentSetSummary? _parentSet;

    protected override async Task OnInitializedAsync()
    {
        _builder = new AssignmentBuilderModel
        {
            AssignmentId = Guid.Empty,
            AssignmentSetId = SetId,                                   // new
            Title = "Math Homework — Week 5",
            Description = "Linear equations, basic geometry, and a short reflection.",
            Exercises = []
        };

        if (SetId is not null && SetId != Guid.Empty)
        {
            try
            {
                _parentSet = await AssignmentSetApi.GetAsync(SetId.Value);
            }
            catch
            {
                // Set load failed — the warning banner will surface that to the user;
                // creation can still proceed standalone if they choose to push through.
                _parentSet = null;
            }
        }

        await LoadCatalogAsync();
    }

    private async Task LoadCatalogAsync()
    {
        try
        {
            var exercises = await ExerciseApi.GetAllAsync();

            _catalog = new ExerciseCatalogModel
            {
                SearchQuery = string.Empty,
                Results = exercises.Select(e => new ExerciseCatalogItemModel
                {
                    Id = e.Id,
                    Title = e.Title,
                    Content = string.Empty,   // ExerciseResponse doesn't carry a description
                    QuestionCount = 0,         // ExerciseResponse doesn't carry a count
                    IsAlreadyInAssignment = false
                }).ToList()
            };
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load exercise catalog: {ex.Message}";
            _catalog = new ExerciseCatalogModel();
        }
    }

    private async Task HandleCreateAssignment()
    {
        if (IsCreated || _isBusy) return;

        if (string.IsNullOrWhiteSpace(_builder.Title))
        {
            _errorMessage = "Please enter a title before creating the assignment.";
            return;
        }

        // Block submission if the parent set is published — server would reject
        // with 409 anyway, but failing fast is friendlier UX.
        if (_parentSet is not null && _parentSet.IsPublished)
        {
            _errorMessage = $"Cannot add assignments to '{_parentSet.Title}' — the set is already published.";
            return;
        }

        var localTitle = _builder.Title;
        var localDescription = _builder.Description;
        var localExercises = _builder.Exercises.ToList();

        _isBusy = true;
        try
        {
            var created = await AssignmentApi.CreateAssignmentAsync(
                localTitle, localDescription, SetId);
            if (created is null)
            {
                _errorMessage = "Server returned an empty response when creating the assignment.";
                return;
            }

            // The server may not echo title/description; keep the user's input.
            created.Title = localTitle;
            created.Description = localDescription;
            created.Exercises = new();

            // 2. Persist each picked exercise. Question-level edits made before Create
            //    aren't replayed — the user can adjust points / remove questions in
            //    saved mode where edits sync immediately.
            foreach (var localEx in localExercises)
            {
                var serverEx = await AssignmentApi.AddExerciseAsync(
                    created.AssignmentId, localEx.SourceExerciseId);
                if (serverEx is null) continue;

                serverEx.Order = created.Exercises.Count;
                created.Exercises.Add(serverEx);
            }

            _builder = created;
            _errorMessage = null;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to create assignment: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private bool IsCreated => _builder.AssignmentId != Guid.Empty;

    private async Task HandleTitleChanged(ChangeEventArgs e)
    {
        _builder.Title = e.Value?.ToString() ?? string.Empty;
        await PersistDetailsAsync();
    }

    private async Task HandleDescriptionChanged(ChangeEventArgs e)
    {
        _builder.Description = e.Value?.ToString() ?? string.Empty;
        await PersistDetailsAsync();
    }

    private async Task PersistDetailsAsync()
    {
        if (!IsCreated)
        {
            _errorMessage = "Click 'Create Assignment' before making changes.";
            return;
        }

        try
        {
            var updated = await AssignmentApi.UpdateAssignmentAsync(
                _builder.AssignmentId, _builder.Title, _builder.Description);

            if (updated is not null)
            {
                // Keep server as source of truth, but preserve local exercise list ordering
                _builder.Title = updated.Title;
                _builder.Description = updated.Description;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to save details: {ex.Message}";
        }
    }

    private async Task HandleAddExercise(ExerciseCatalogItemModel item)
    {
        if (item.IsAlreadyInAssignment) return;

        if (!IsCreated)
        {
            try
            {
                var snapshot = await ExerciseApi.GetSnapshotAsync(item.Id);
                if (snapshot is null)
                {
                    _errorMessage = "Exercise is no longer available.";
                    return;
                }

                var localExercise = new AssignmentExerciseModel
                {
                    Id = Guid.NewGuid(),                       // local placeholder; server issues a real id on Create
                    SourceExerciseId = snapshot.Id,
                    Title = snapshot.Title,
                    Content = snapshot.Description ?? string.Empty,
                    Order = _builder.Exercises.Count,
                    SnapshotTakenAt = DateTime.UtcNow,
                    Questions = snapshot.Questions
    .Select((q, i) => new AssignmentQuestionModel
    {
        Id = Guid.NewGuid(),               // local placeholder
        Title = string.IsNullOrWhiteSpace(q.Title) ? $"Question {i + 1}" : q.Title,
        Content = q.Content,
        Points = 0,
        Order = i
    })
    .ToList()
                };

                _builder.Exercises.Add(localExercise);
                item.IsAlreadyInAssignment = true;
            }
            catch (Exception ex)
            {
                _errorMessage = $"Failed to load exercise: {ex.Message}";
            }
            return;
        }

        try
        {
            var added = await AssignmentApi.AddExerciseAsync(_builder.AssignmentId, item.Id);
            if (added is not null)
            {
                added.Order = _builder.Exercises.Count;
                _builder.Exercises.Add(added);
                item.IsAlreadyInAssignment = true;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to add exercise: {ex.Message}";
        }
    }

    private async Task HandlePreviewExercise(ExerciseCatalogItemModel item)
    {
        try
        {
            var review = await ExerciseApi.GetReviewAsync(item.Id);
            if (review is null)
            {
                _errorMessage = "Exercise is no longer available.";
                return;
            }

            _currentPreview = new ExercisePreviewModel
            {
                Id = review.Id,
                Title = review.Title,
                Content = review.Description ?? string.Empty,
                SolutionContent = null,        // ExerciseReviewResponse has no exercise-level solution field
                SolutionVideoUrl = null,
                Questions = review.Questions
    .Select((q, i) => new ExercisePreviewQuestionModel
    {
        Id = q.Id,
        Title = string.IsNullOrWhiteSpace(q.Title) ? $"Question {i + 1}" : q.Title,
        Content = q.Content,
        SolutionContent = q.Solution
    })
    .ToList()
            };
            _isPreviewOpen = true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load preview: {ex.Message}";
        }
    }

    private void ClosePreview() => _isPreviewOpen = false;

    private async Task HandleRemoveExercise(Guid assignmentExerciseId)
    {
        var ae = _builder.Exercises.FirstOrDefault(e => e.Id == assignmentExerciseId);
        if (ae is null) return;

        if (!IsCreated)
        {
            _builder.Exercises.Remove(ae);
            var localCatalogItem = _catalog.Results.FirstOrDefault(i => i.Id == ae.SourceExerciseId);
            if (localCatalogItem != null) localCatalogItem.IsAlreadyInAssignment = false;
            return;
        }

        try
        {
            await AssignmentApi.RemoveExerciseAsync(_builder.AssignmentId, assignmentExerciseId);

            _builder.Exercises.Remove(ae);
            var catalogItem = _catalog.Results.FirstOrDefault(i => i.Id == ae.SourceExerciseId);
            if (catalogItem != null) catalogItem.IsAlreadyInAssignment = false;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to remove exercise: {ex.Message}";
        }
    }

    private async Task HandleRemoveQuestion(RemoveQuestionEventArgs args)
    {
        var ae = _builder.Exercises.FirstOrDefault(e => e.Id == args.AssignmentExerciseId);
        var q = ae?.Questions.FirstOrDefault(qq => qq.Id == args.QuestionId);
        if (ae is null || q is null) return;

        if (!IsCreated)
        {
            ae.Questions.Remove(q);
            return;
        }

        try
        {
            await AssignmentApi.RemoveQuestionAsync(_builder.AssignmentId, ae.Id, q.Id);
            ae.Questions.Remove(q);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to remove question: {ex.Message}";
        }
    }

    private async Task HandleSetQuestionPoints(SetQuestionPointsEventArgs args)
    {
        var ae = _builder.Exercises.FirstOrDefault(e => e.Id == args.AssignmentExerciseId);
        var q = ae?.Questions.FirstOrDefault(qq => qq.Id == args.QuestionId);
        if (ae is null || q is null) return;

        if (!IsCreated)
        {
            q.Points = args.Points;
            return;
        }

        try
        {
            await AssignmentApi.SetQuestionPointsAsync(_builder.AssignmentId, ae.Id, q.Id, args.Points);
            q.Points = args.Points;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to set points: {ex.Message}";
        }
    }

    private async Task HandleGeneratePdf()
    {
        if (_builder.AssignmentId == Guid.Empty || _isBusy) return;

        _isBusy = true;
        try
        {
            var bytes = await AssignmentApi.GetPdfAsync(_builder.AssignmentId);

            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync(
                "downloadFileFromStream",
                $"assignment-{_builder.AssignmentId:D}.pdf",
                streamRef);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to generate PDF: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }
}