@using Assign.Web.Teacher.Models.Assignment

<div class="position-relative mb-3">
    <i class="bi bi-search position-absolute top-50 translate-middle-y ms-3 text-muted"></i>
    <input class="form-control ps-5"
           placeholder="Search exercises by title or content..."
           @bind="Catalog.SearchQuery"
           @bind:event="oninput" />
</div>

<p class="small text-muted mb-2">
    @FilteredResults.Count() exercise@(FilteredResults.Count() == 1 ? "" : "s") found
</p>

<div class="d-flex flex-column gap-2" style="max-height: 600px; overflow-y: auto;">
    @foreach (var item in FilteredResults)
    {
        <div class="card">
            <div class="card-body py-2">
                <div class="d-flex align-items-start justify-content-between gap-2">
                    <div class="flex-grow-1 min-width-0">
                        <h6 class="mb-1">@item.Title</h6>
                        <p class="small text-muted mb-1">@item.Content</p>
                        <span class="badge bg-light text-dark">
                            <i class="bi bi-list-ol me-1"></i>
                            @item.QuestionCount question@(item.QuestionCount == 1 ? "" : "s")
                        </span>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="() => OnPreviewExercise.InvokeAsync(item)">
                            <i class="bi bi-eye me-1"></i>View
                        </button>
                        <button class="btn btn-sm btn-primary"
                                disabled="@item.IsAlreadyInAssignment"
                                @onclick="() => OnAddExercise.InvokeAsync(item)">
                            <i class="bi @(item.IsAlreadyInAssignment ? "bi-check-lg" : "bi-plus-lg") me-1"></i>
                            @(item.IsAlreadyInAssignment ? "Added" : "Add")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!FilteredResults.Any())
    {
        <div class="text-center text-muted py-4">
            No exercises match your search.
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ExerciseCatalogModel Catalog { get; set; } = new();
    [Parameter] public EventCallback<ExerciseCatalogItemModel> OnAddExercise { get; set; }
    [Parameter] public EventCallback<ExerciseCatalogItemModel> OnPreviewExercise { get; set; }

    private IEnumerable<ExerciseCatalogItemModel> FilteredResults
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Catalog.SearchQuery))
                return Catalog.Results;

            var q = Catalog.SearchQuery.Trim();
            return Catalog.Results.Where(r =>
                r.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                r.Content.Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }
}