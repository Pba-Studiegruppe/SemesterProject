@page "/assignment-sets"
@rendermode InteractiveServer
@using Assign.Web.Teacher.Models.AssignmentSet
@using Assign.Web.Teacher.Services.ApiClients
@inject AssignmentSetApiClient AssignmentSetApi
@inject NavigationManager Nav

<PageTitle>Assignment Sets</PageTitle>

<div class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto px-6 py-6">

        <!-- Breadcrumb + heading + create button -->
        <div class="flex items-start justify-between mb-6">
            <div>
                <nav class="text-sm text-gray-500 mb-1">
                    <a href="/" class="hover:text-gray-700">Dashboard</a>
                    <span class="mx-1">/</span>
                    <span class="text-gray-900">Assignment Sets</span>
                </nav>
                <h1 class="text-2xl font-semibold text-gray-900">Assignment Sets</h1>
            </div>

            <button type="button"
                    @onclick="CreateNew"
                    class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                + Create Assignment Set
            </button>
        </div>

        <!-- Toolbar -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
            <div class="flex flex-col md:flex-row gap-3">
                <div class="flex-1">
                    <input type="text"
                           placeholder="Search by title..."
                           @bind="_searchQuery"
                           @bind:event="oninput"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                </div>
                <div class="md:w-48">
                    <select @bind="_statusFilter"
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="all">All statuses</option>
                        <option value="draft">Draft</option>
                        <option value="published">Published</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Content -->
        @if (_isLoading)
        {
            <div class="text-center py-16 text-gray-500">
                <p>Loading assignment sets…</p>
            </div>
        }
        else if (_error is not null)
        {
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700">
                <div class="flex items-center justify-between">
                    <p>Failed to load assignment sets: @_error</p>
                    <button type="button"
                            @onclick="LoadAsync"
                            class="px-3 py-1.5 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700">
                        Retry
                    </button>
                </div>
            </div>
        }
        else if (!FilteredSets.Any())
        {
            <div class="text-center py-16 bg-white rounded-lg border border-gray-200">
                @if (_sets.Count == 0)
                {
                    <p class="text-gray-500 mb-4">No assignment sets yet.</p>
                    <button type="button"
                            @onclick="CreateNew"
                            class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700">
                        Create your first one
                    </button>
                }
                else
                {
                    <p class="text-gray-500">No assignment sets match your filters.</p>
                }
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var s in FilteredSets)
                {
                    <button type="button"
                            @onclick="() => OpenSet(s.Id)"
                            class="text-left bg-white rounded-lg border border-gray-200 p-5 hover:border-blue-400 hover:shadow-md transition-all">

                        <div class="flex items-start justify-between mb-2">
                            <h3 class="text-lg font-semibold text-gray-900 line-clamp-2 flex-1 pr-2">
                                @(string.IsNullOrWhiteSpace(s.Title) ? "(Untitled)" : s.Title)
                            </h3>
                            <span class="@StatusBadgeClass(s) inline-flex items-center px-2 py-0.5 rounded text-xs font-medium whitespace-nowrap">
                                @StatusOf(s)
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(s.Description))
                        {
                            <p class="text-sm text-gray-600 mb-4 line-clamp-2">@s.Description</p>
                        }
                        else
                        {
                            <p class="text-sm text-gray-400 italic mb-4">No description</p>
                        }

                        <div class="flex items-center justify-between text-xs text-gray-500 pt-3 border-t border-gray-100">
                            <span>@s.AssignmentCount assignment@(s.AssignmentCount == 1 ? "" : "s")</span>
                            @if (s.GradingPublished)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-medium">
                                    Grading published
                                </span>
                            }
                        </div>

                        <div class="mt-2 text-xs text-gray-400 font-mono truncate">
                            @if (s.CourseId is null)
                            {
                                <span>No course</span>
                            }
                            else
                            {
                                <span>Course: @s.CourseId</span>
                            }
                        </div>
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<AssignmentSetSummary> _sets = new();
    private bool _isLoading = true;
    private string? _error;

    private string _searchQuery = string.Empty;
    private string _statusFilter = "all";

    private IEnumerable<AssignmentSetSummary> FilteredSets =>
        _sets
            .Where(s => string.IsNullOrWhiteSpace(_searchQuery)
                || (s.Title?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false))
            .Where(s => _statusFilter switch
            {
                "draft" => !s.IsPublished && !s.Inactive,
                "published" => s.IsPublished && !s.Inactive,
                "inactive" => s.Inactive,
                _ => true
            });

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var result = await AssignmentSetApi.GetAllAsync();
            _sets = result.ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenSet(Guid id) => Nav.NavigateTo($"/assignment-sets/{id}");

    // Route doesn't exist yet — placeholder for a future create page.
    private void CreateNew() => Nav.NavigateTo("/assignment-sets/create");

    private static string StatusOf(AssignmentSetSummary s)
    {
        if (s.Inactive) return "Inactive";
        if (s.IsPublished) return "Published";
        return "Draft";
    }

    private static string StatusBadgeClass(AssignmentSetSummary s)
    {
        if (s.Inactive) return "bg-gray-100 text-gray-600";
        if (s.IsPublished) return "bg-green-100 text-green-700";
        return "bg-yellow-100 text-yellow-700";
    }
}
