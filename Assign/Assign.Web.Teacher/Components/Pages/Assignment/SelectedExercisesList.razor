@using Assign.Web.Teacher.Models.Assignment

@if (Exercises.Count == 0)
{
    <div class="text-center text-muted py-4">
        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
        No exercises added yet.<br />
        Pick some from the catalog on the right.
    </div>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var (ae, idx) in Exercises.Select((e, i) => (e, i)))
        {
            <div class="border rounded p-2">
                <div class="d-flex align-items-start gap-2">
                    <button class="btn btn-sm btn-link p-0"
                            @onclick="() => ToggleExpand(ae)"
                            title="@(ae.IsExpanded ? "Collapse" : "Expand")">
                        <i class="bi @(ae.IsExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                    </button>

                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="fw-medium">#@(idx + 1)</span>
                                <span class="ms-1">@ae.Title</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-dark">@ae.TotalPoints pts</span>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => OnRemoveExercise.InvokeAsync(ae.Id)"
                                        title="Remove this exercise">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(ae.Content))
                        {
                            <p class="text-muted small mb-0 text-truncate">@ae.Content</p>
                        }

                        @if (ae.IsExpanded)
                        {
                            <div class="mt-2 ps-2 border-start">
                                @if (ae.Questions.Count == 0)
                                {
                                    <p class="text-muted small mb-0 fst-italic">No questions in this exercise.</p>
                                }
                                else
                                {
                                    @foreach (var q in ae.Questions)
                                    {
                                        <div class="d-flex align-items-center gap-2 py-1">
                                            <div class="flex-grow-1 small">@q.Title</div>
                                            <input type="number" min="0"
                                                   class="form-control form-control-sm"
                                                   style="width: 80px;"
                                                   value="@q.Points"
                                                   @onchange="@(e => HandlePointsChanged(ae, q, e))" />
                                            <span class="small text-muted">pts</span>
                                            <button class="btn btn-sm btn-link text-danger p-0"
                                                    @onclick="() => OnRemoveQuestion.InvokeAsync(new RemoveQuestionEventArgs(ae.Id, q.Id))"
                                                    title="Remove this question">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public List<AssignmentExerciseModel> Exercises { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnRemoveExercise { get; set; }
    [Parameter] public EventCallback<RemoveQuestionEventArgs> OnRemoveQuestion { get; set; }
    [Parameter] public EventCallback<SetQuestionPointsEventArgs> OnSetQuestionPoints { get; set; }

    private void ToggleExpand(AssignmentExerciseModel ae) => ae.IsExpanded = !ae.IsExpanded;

    private async Task HandlePointsChanged(AssignmentExerciseModel ae, AssignmentQuestionModel q, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var points) && points >= 0)
        {
            await OnSetQuestionPoints.InvokeAsync(new SetQuestionPointsEventArgs(ae.Id, q.Id, points));
        }
    }
}