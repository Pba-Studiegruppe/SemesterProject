@page "/assignment-sets/{Id:guid}"
@using Assign.Web.Teacher.Models.AssignmentSet
@using Assign.Web.Teacher.Services.ApiClients
@inject AssignmentSetApiClient AssignmentSetApi
@inject NavigationManager Nav

<PageTitle>@(_set?.Title ?? "Assignment Set")</PageTitle>

<div class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto px-6 py-6">

        <!-- Breadcrumb -->
        <nav class="text-sm text-gray-500 mb-4">
            <a href="/" class="hover:text-gray-700">Dashboard</a>
            <span class="mx-1">/</span>
            <a href="/assignment-sets" class="hover:text-gray-700">Assignment Sets</a>
            <span class="mx-1">/</span>
            <span class="text-gray-900">
                @(_set?.Title ?? (_isLoading ? "Loading…" : "Not found"))
            </span>
        </nav>

        @if (_isLoading)
        {
            <div class="text-center py-16 text-gray-500">
                <p>Loading assignment set…</p>
            </div>
        }
        else if (_loadError is not null)
        {
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700">
                <div class="flex items-center justify-between">
                    <p>Failed to load assignment set: @_loadError</p>
                    <button type="button"
                            @onclick="LoadAsync"
                            class="px-3 py-1.5 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700">
                        Retry
                    </button>
                </div>
            </div>
        }
        else if (_set is null)
        {
            <div class="bg-white rounded-lg border border-gray-200 p-8 text-center">
                <p class="text-gray-700 mb-4">This assignment set doesn't exist.</p>
                <a href="/assignment-sets"
                   class="inline-block px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700">
                    Back to Assignment Sets
                </a>
            </div>
        }
        else
        {
            <!-- Header card -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex-1 pr-4">
                        <div class="flex items-center gap-3 mb-2">
                            <h1 class="text-2xl font-semibold text-gray-900">
                                @(string.IsNullOrWhiteSpace(_set.Title) ? "(Untitled)" : _set.Title)
                            </h1>
                            <span class="@StatusBadgeClass(_set) inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium">
                                @StatusOf(_set)
                            </span>
                            @if (_set.GradingPublished)
                            {
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded bg-blue-50 text-blue-700 text-xs font-medium">
                                    Grading published
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_set.Description))
                        {
                            <p class="text-gray-600 mb-4">@_set.Description</p>
                        }
                        else
                        {
                            <p class="text-gray-400 italic mb-4">No description</p>
                        }

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
                            <div>
                                <div class="text-gray-500 text-xs uppercase tracking-wide mb-1">Course</div>
                                <div class="font-mono text-xs text-gray-700 truncate">
                                    @(_set.CourseId?.ToString() ?? "—")
                                </div>
                            </div>
                            <div>
                                <div class="text-gray-500 text-xs uppercase tracking-wide mb-1">Created</div>
                                <div class="text-gray-700">
                                    @(_set.CreatedAt?.ToString("yyyy-MM-dd") ?? "—")
                                </div>
                            </div>
                            <div>
                                <div class="text-gray-500 text-xs uppercase tracking-wide mb-1">Assignments</div>
                                <div class="text-gray-700">@_set.AssignmentCount</div>
                            </div>
                        </div>
                    </div>

                    <!-- Action buttons -->
                    <div class="flex flex-col gap-2 shrink-0">
                        @if (_set.IsPublished)
                        {
                            <button type="button"
                                    disabled
                                    class="px-4 py-2 bg-gray-100 text-gray-500 text-sm font-medium rounded-lg cursor-not-allowed">
                                Published
                            </button>
                        }
                        else if (PublishDisabledReason is null)
                        {
                            <button type="button"
                                    @onclick="RequestPublish"
                                    class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700">
                                Publish
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    disabled
                                    title="@PublishDisabledReason"
                                    class="px-4 py-2 bg-gray-100 text-gray-400 text-sm font-medium rounded-lg cursor-not-allowed">
                                Publish
                            </button>
                        }
                    </div>
                </div>

                @if (PublishDisabledReason is not null && !_set.IsPublished)
                {
                    <div class="mt-2 text-xs text-gray-500">
                        Can't publish yet: @PublishDisabledReason.
                    </div>
                }

                @if (_publishError is not null)
                {
                    <div class="mt-3 bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">
                        @_publishError
                    </div>
                }
            </div>

            <!-- Assignments section -->
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-lg font-semibold text-gray-900">Assignments</h2>
                @if (!_set.IsPublished)
                {
                    <button type="button"
                            @onclick="CreateAssignment"
                            class="px-3 py-1.5 bg-white border border-gray-300 text-gray-700 text-sm rounded-lg hover:border-blue-400 hover:text-blue-700">
                        + Create Assignment
                    </button>
                }
            </div>

            @if (_set.AssignmentCount == 0)
            {
                <div class="text-center py-12 bg-white rounded-lg border border-gray-200">
                    <p class="text-gray-500 mb-4">No assignments in this set yet.</p>
                    @if (!_set.IsPublished)
                    {
                        <button type="button"
                                @onclick="CreateAssignment"
                                class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700">
                            Add the first assignment
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var a in _set.Assignments)
                    {
                        <button type="button"
                                @onclick="() => OpenAssignment(a.Id)"
                                class="text-left bg-white rounded-lg border border-gray-200 p-4 hover:border-blue-400 hover:shadow-md transition-all">

                            <h3 class="text-base font-semibold text-gray-900 mb-2 line-clamp-2">
                                @(string.IsNullOrWhiteSpace(a.Title) ? "(Untitled)" : a.Title)
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(a.Description))
                            {
                                <p class="text-sm text-gray-600 mb-3 line-clamp-2">@a.Description</p>
                            }
                            else
                            {
                                <p class="text-sm text-gray-400 italic mb-3">No description</p>
                            }

                            <div class="flex items-center justify-between text-xs text-gray-500 pt-3 border-t border-gray-100">
                                <span>
                                    @a.ExerciseCount exercise@(a.ExerciseCount == 1 ? "" : "s")
                                </span>
                                <span class="font-medium text-gray-700">
                                    @(a.TotalPoints ?? 0) pts
                                </span>
                            </div>

                            @if (a.ExerciseCount == 0)
                            {
                                <div class="mt-2 text-xs text-yellow-700 bg-yellow-50 border border-yellow-200 rounded px-2 py-1">
                                    Missing exercises — blocks publish
                                </div>
                            }
                        </button>
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Publish confirmation modal -->
@if (_showConfirmPublish && _set is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40">
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
                Publish this assignment set?
            </h3>
            <p class="text-sm text-gray-600 mb-4">
                Once published, you won't be able to add new assignments to this set.
                Existing assignments stay editable, and students will be able to receive them.
            </p>

            <div class="flex justify-end gap-2">
                <button type="button"
                        @onclick="CancelPublish"
                        disabled="@_isPublishing"
                        class="px-4 py-2 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50">
                    Cancel
                </button>
                <button type="button"
                        @onclick="ConfirmPublishAsync"
                        disabled="@_isPublishing"
                        class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 disabled:bg-blue-300">
                    @(_isPublishing ? "Publishing…" : "Publish")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AssignmentSetSummary? _set;
    private bool _isLoading = true;
    private string? _loadError;

    private bool _showConfirmPublish;
    private bool _isPublishing;
    private string? _publishError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            _set = await AssignmentSetApi.GetAsync(Id);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _set = null;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string? PublishDisabledReason
    {
        get
        {
            if (_set is null) return "Set hasn't loaded";
            if (_set.IsPublished) return "Already published";
            if (_set.CourseId is null) return "This set has no course assigned";
            if (_set.AssignmentCount == 0) return "Add at least one assignment first";
            if (_set.Assignments.Any(a => a.ExerciseCount == 0))
                return "Every assignment must have at least one exercise";
            return null;
        }
    }

    private void RequestPublish()
    {
        _publishError = null;
        _showConfirmPublish = true;
    }

    private void CancelPublish() => _showConfirmPublish = false;

    private async Task ConfirmPublishAsync()
    {
        _isPublishing = true;
        _publishError = null;
        try
        {
            var updated = await AssignmentSetApi.PublishAsync(Id);
            if (updated is not null) _set = updated;
            _showConfirmPublish = false;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _publishError = "Server rejected the publish — domain rules weren't satisfied.";
        }
        catch (Exception ex)
        {
            _publishError = $"Failed to publish: {ex.Message}";
        }
        finally
        {
            _isPublishing = false;
        }
    }

    // Detail page for an Assignment — routed under /assignments/{id}.
    // The page itself doesn't exist yet; this is wired up in advance.
    private void OpenAssignment(Guid assignmentId) =>
        Nav.NavigateTo($"/assignments/{assignmentId}");

    // Existing Create Assignment page; passes the parent set id so that
    // page can pre-populate the AssignmentSetId on the request once it
    // supports it (currently doesn't — query param will just be ignored).
    private void CreateAssignment() =>
        Nav.NavigateTo($"/assignments/create?setId={Id}");

    private static string StatusOf(AssignmentSetSummary s)
    {
        if (s.Inactive) return "Inactive";
        if (s.IsPublished) return "Published";
        return "Draft";
    }

    private static string StatusBadgeClass(AssignmentSetSummary s)
    {
        if (s.Inactive) return "bg-gray-100 text-gray-600";
        if (s.IsPublished) return "bg-green-100 text-green-700";
        return "bg-yellow-100 text-yellow-700";
    }
}
