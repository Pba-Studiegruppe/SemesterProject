@page "/assignments/{Id:guid}"
@rendermode InteractiveServer
@using Assign.Web.Teacher.Models.Assignment
@using Assign.Web.Teacher.Models.AssignmentSet
@using Assign.Web.Teacher.Services.ApiClients
@inject AssignmentApiClient AssignmentApi
@inject AssignmentSetApiClient AssignmentSetApi
@inject SubmittedAssignmentApiClient SubmittedAssignmentApi
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>@(_assignment?.Title ?? "Assignment")</PageTitle>

<div class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto px-6 py-6">

        <!-- Breadcrumb -->
        <nav class="text-sm text-gray-500 mb-4">
            <a href="/" class="hover:text-gray-700">Dashboard</a>
            <span class="mx-1">/</span>
            <a href="/assignment-sets" class="hover:text-gray-700">Assignment Sets</a>
            @if (_parentSet is not null)
            {
                <span class="mx-1">/</span>
                <a href="/assignment-sets/@_parentSet.Id" class="hover:text-gray-700">
                    @(string.IsNullOrWhiteSpace(_parentSet.Title) ? "(Untitled)" : _parentSet.Title)
                </a>
            }
            <span class="mx-1">/</span>
            <span class="text-gray-900">
                @(_assignment?.Title ?? (_isLoading ? "Loading…" : "Not found"))
            </span>
        </nav>

        @if (_isLoading)
        {
            <div class="text-center py-16 text-gray-500">
                <p>Loading assignment…</p>
            </div>
        }
        else if (_loadError is not null)
        {
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700">
                <div class="flex items-center justify-between">
                    <p>Failed to load assignment: @_loadError</p>
                    <button type="button"
                            @onclick="LoadAsync"
                            class="px-3 py-1.5 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700">
                        Retry
                    </button>
                </div>
            </div>
        }
        else if (_assignment is null)
        {
            <div class="bg-white rounded-lg border border-gray-200 p-8 text-center">
                <p class="text-gray-700 mb-4">This assignment doesn't exist.</p>
                <a href="/assignment-sets"
                   class="inline-block px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700">
                    Back to Assignment Sets
                </a>
            </div>
        }
        else
        {
            <!-- Header card -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex-1 pr-4">
                        <h1 class="text-2xl font-semibold text-gray-900 mb-2">
                            @(string.IsNullOrWhiteSpace(_assignment.Title) ? "(Untitled)" : _assignment.Title)
                        </h1>

                        @if (_parentSet is not null)
                        {
                            <div class="flex items-center gap-2 text-sm text-gray-600 mb-3">
                                <span>Part of</span>
                                <a href="/assignment-sets/@_parentSet.Id"
                                   class="text-blue-600 hover:text-blue-700 font-medium">
                                    @(_parentSet.Title ?? "(Untitled set)")
                                </a>
                                <span class="@SetStatusBadgeClass(_parentSet) inline-flex items-center px-2 py-0.5 rounded text-xs font-medium">
                                    @SetStatusLabel(_parentSet)
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="text-sm text-gray-500 italic mb-3">Standalone assignment (not part of any set)</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_assignment.Description))
                        {
                            <p class="text-gray-600 mb-4">@_assignment.Description</p>
                        }
                        else
                        {
                            <p class="text-gray-400 italic mb-4">No description</p>
                        }

                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
                            <div>
                                <div class="text-gray-500 text-xs uppercase tracking-wide mb-1">Exercises</div>
                                <div class="text-gray-700">@_assignment.Exercises.Count</div>
                            </div>
                            <div>
                                <div class="text-gray-500 text-xs uppercase tracking-wide mb-1">Total points</div>
                                <div class="text-gray-700">@_assignment.TotalPoints</div>
                            </div>
                            <div>
                                <div class="text-gray-500 text-xs uppercase tracking-wide mb-1">Submissions</div>
                                <div class="text-gray-700">@_submissions.Count</div>
                            </div>
                        </div>
                    </div>

                    <!-- Action buttons -->
                    <div class="flex flex-col gap-2 shrink-0">
                        <button type="button"
                                @onclick="EditAssignment"
                                class="px-4 py-2 bg-white border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:border-blue-400 hover:text-blue-700">
                            Edit
                        </button>
                        <a href="@PdfUrl"
                           target="_blank"
                           rel="noopener"
                           class="text-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700">
                            View PDF
                        </a>
                    </div>
                </div>
            </div>

            <!-- Submissions section -->
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-lg font-semibold text-gray-900">
                    Submissions <span class="text-gray-500 text-sm font-normal">(@_submissions.Count)</span>
                </h2>
                <button type="button"
                        disabled
                        title="Available once the Course / Students module lands"
                        class="px-3 py-1.5 bg-gray-100 text-gray-400 text-sm rounded-lg cursor-not-allowed">
                    + Register submission
                </button>
            </div>

            @if (_submissionsError is not null)
            {
                <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700">
                    Could not load submissions: @_submissionsError
                </div>
            }
            else if (_submissions.Count == 0)
            {
                <div class="text-center py-12 bg-white rounded-lg border border-gray-200">
                    <p class="text-gray-500">No submissions yet for this assignment.</p>
                </div>
            }
            else
            {
                <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 text-gray-600 text-xs uppercase tracking-wide">
                            <tr>
                                <th class="text-left px-4 py-3 font-medium">Student</th>
                                <th class="text-left px-4 py-3 font-medium">Status</th>
                                <th class="text-left px-4 py-3 font-medium">Score</th>
                                <th class="text-right px-4 py-3 font-medium">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var s in _submissions)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-4 py-3 font-mono text-xs text-gray-600">
                                        @s.StudentId
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="@SubmissionStatusBadgeClass(s.Status) inline-flex items-center px-2 py-0.5 rounded text-xs font-medium">
                                            @SubmissionStatusLabel(s.Status)
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-gray-700">
                                        @if (s.Status == EvaluationStatus.Pending)
                                        {
                                            <span class="text-gray-400">—</span>
                                        }
                                        else
                                        {
                                            <span>@s.TotalScore / @s.MaxPossibleScore</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <button type="button"
                                                @onclick="() => EvaluateSubmission(s.Id)"
                                                class="px-3 py-1.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700">
                                            @ActionLabel(s.Status)
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private AssignmentBuilderModel? _assignment;
    private AssignmentSetSummary? _parentSet;
    private List<SubmittedAssignmentSummary> _submissions = new();

    private bool _isLoading = true;
    private string? _loadError;
    private string? _submissionsError;

    // Direct link to the PDF endpoint — bypasses the API client because
    // browsers handle Content-Disposition / inline PDF rendering natively.
    private string PdfUrl =>
        $"{(Config["AssignmentApi:BaseUrl"] ?? "").TrimEnd('/')}/api/assignments/{Id}/pdf";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        _submissionsError = null;

        try
        {
            // Load the assignment first — we need its AssignmentSetId before we
            // can fetch the parent set.
            _assignment = await AssignmentApi.GetAssignmentAsync(Id);

            if (_assignment is not null)
            {
                // Parent set + submissions can run in parallel since they're
                // independent.
                var setTask = LoadParentSetAsync(_assignment.AssignmentSetId);
                var submissionsTask = LoadSubmissionsAsync();

                await Task.WhenAll(setTask, submissionsTask);
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _assignment = null;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadParentSetAsync(Guid? setId)
    {
        if (setId is null || setId == Guid.Empty)
        {
            _parentSet = null;
            return;
        }

        try
        {
            _parentSet = await AssignmentSetApi.GetAsync(setId.Value);
        }
        catch
        {
            // Non-fatal — page still renders without parent-set context.
            _parentSet = null;
        }
    }

    private async Task LoadSubmissionsAsync()
    {
        try
        {
            var result = await SubmittedAssignmentApi.GetByAssignmentAsync(Id);
            _submissions = result.ToList();
        }
        catch (Exception ex)
        {
            _submissionsError = ex.Message;
            _submissions = new();
        }
    }

    private void EvaluateSubmission(Guid submissionId) =>
        Nav.NavigateTo($"/submissions/{submissionId}/evaluate");

    // Route doesn't exist yet — placeholder for the future Edit page.
    private void EditAssignment() =>
        Nav.NavigateTo($"/assignments/{Id}/edit");

    // ── presentation helpers ──────────────────────────────────────────────

    private static string SetStatusLabel(AssignmentSetSummary s)
    {
        if (s.Inactive) return "Inactive";
        if (s.IsPublished) return "Published";
        return "Draft";
    }

    private static string SetStatusBadgeClass(AssignmentSetSummary s)
    {
        if (s.Inactive) return "bg-gray-100 text-gray-600";
        if (s.IsPublished) return "bg-green-100 text-green-700";
        return "bg-yellow-100 text-yellow-700";
    }

    private static string SubmissionStatusLabel(EvaluationStatus status) => status switch
    {
        EvaluationStatus.Pending => "Pending",
        EvaluationStatus.InProgress => "In Progress",
        EvaluationStatus.Completed => "Completed",
        EvaluationStatus.Returned => "Returned",
        _ => "Unknown",
    };

    private static string SubmissionStatusBadgeClass(EvaluationStatus status) => status switch
    {
        EvaluationStatus.Pending => "bg-yellow-100 text-yellow-700",
        EvaluationStatus.InProgress => "bg-blue-100 text-blue-700",
        EvaluationStatus.Completed => "bg-green-100 text-green-700",
        EvaluationStatus.Returned => "bg-gray-200 text-gray-700",
        _ => "bg-gray-100 text-gray-600",
    };

    private static string ActionLabel(EvaluationStatus status) => status switch
    {
        EvaluationStatus.Pending => "Evaluate",
        EvaluationStatus.InProgress => "Continue",
        EvaluationStatus.Completed => "Review",
        EvaluationStatus.Returned => "View",
        _ => "Open",
    };
}
