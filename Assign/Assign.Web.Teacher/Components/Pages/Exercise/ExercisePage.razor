@page "/exercises"

@using System.Globalization

<div class="min-vh-100 bg-light d-flex">

    <!-- Sidebar -->
    <div class="border-end bg-white p-4" style="width: 260px;">
        <h6 class="text-muted mb-3">QUICK FILTERS</h6>

        <div class="d-grid gap-2 mb-4">
            <button class="btn btn-light text-start">Recently Edited</button>
            <button class="btn btn-light text-start">Most Used</button>
            <button class="btn btn-light text-start">Drafts</button>
            <button class="btn btn-light text-start">Published</button>
            <button class="btn btn-light text-start">Shared with School</button>
        </div>

        <h6 class="text-muted mb-3">SUBJECTS</h6>

        <div class="d-grid gap-2">
            <button class="btn btn-light text-start d-flex justify-content-between">
                Math <span class="text-muted">12</span>
            </button>
            <button class="btn btn-light text-start d-flex justify-content-between">
                Physics <span class="text-muted">8</span>
            </button>
            <button class="btn btn-light text-start d-flex justify-content-between">
                Chemistry <span class="text-muted">6</span>
            </button>
            <button class="btn btn-light text-start d-flex justify-content-between">
                English <span class="text-muted">4</span>
            </button>
        </div>
    </div>

    <!-- Main -->
    <div class="flex-grow-1 p-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <nav class="small text-muted">
                    Dashboard / <span class="text-dark">Exercises</span>
                </nav>
                <h2 class="mb-0">Exercises</h2>
            </div>

            <button class="btn btn-primary" @onclick="OnCreateExercise">
                + Create Exercise
            </button>
        </div>

        <!-- Toolbar -->
        <div class="card p-3 mb-3">
            <div class="row g-2 align-items-center">

                <div class="col-md-3">
                    <input class="form-control"
                           placeholder="Search exercises..."
                           @bind="SearchQuery" />
                </div>

                <div class="col-md-2">
                    <select class="form-select" @bind="SelectedSubject">
                        <option value="all">All Subjects</option>
                        <option>Math</option>
                        <option>Physics</option>
                        <option>Chemistry</option>
                        <option>English</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select class="form-select" @bind="SelectedType">
                        <option value="all">All Types</option>
                        <option>Multiple Choice</option>
                        <option>Theory</option>
                        <option>Calculation</option>
                        <option>Essay</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select class="form-select" @bind="SelectedDifficulty">
                        <option value="all">All Levels</option>
                        <option>Easy</option>
                        <option>Medium</option>
                        <option>Hard</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select class="form-select" @bind="SelectedVisibility">
                        <option value="all">All</option>
                        <option>Private</option>
                        <option>Shared with School</option>
                    </select>
                </div>

                <div class="col-md-1 text-end">
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="ToggleView">
                        @(ViewMode == "table" ? "Grid" : "Table")
                    </button>
                </div>

            </div>

            @if (SelectedExercises.Count > 0)
            {
                <div class="mt-3 border-top pt-2 d-flex gap-2 flex-wrap">
                    <small class="text-muted">@SelectedExercises.Count selected</small>
                    <button class="btn btn-outline-primary btn-sm">Export PDF</button>
                    <button class="btn btn-outline-secondary btn-sm">Duplicate</button>
                    <button class="btn btn-outline-warning btn-sm">Archive</button>
                    <button class="btn btn-outline-danger btn-sm">Delete</button>
                </div>
            }
        </div>

        <!-- Table View -->
        @if (ViewMode == "table")
        {
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox"
                                           @onchange="ToggleSelectAll" />
                                </th>
                                <th>Title</th>
                                <th>Subject</th>
                                <th>Type</th>
                                <th>Difficulty</th>
                                <th>Questions</th>
                                <th>Used</th>
                                <th>Updated</th>
                                <th>Visibility</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var ex in FilteredExercises)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               checked="@SelectedExercises.Contains(ex.Id)"
                                               @onchange="() => ToggleSelect(ex.Id)" />
                                    </td>
                                    <td>
                                        <div>@ex.Title</div>
                                        <small class="text-muted">@ex.Description</small>
                                    </td>
                                    <td>@string.Join(", ", ex.Subject)</td>
                                    <td>@string.Join(", ", ex.Type)</td>
                                    <td>
                                        <span class="badge bg-secondary">@ex.Difficulty</span>
                                    </td>
                                    <td>@ex.QuestionCount</td>
                                    <td>@ex.UsageCount</td>
                                    <td>@ex.LastUpdated.ToString("MMM dd yyyy")</td>
                                    <td>@ex.Visibility</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Grid View -->
        else
        {
        <div class="row g-3">
            @foreach (var ex in FilteredExercises)
            {
                <div class="col-md-4">
                    <div class="card p-3 h-100">
                        <div class="d-flex justify-content-between">
                            <input type="checkbox"
                                   checked="@SelectedExercises.Contains(ex.Id)"
                                   @onchange="() => ToggleSelect(ex.Id)" />
                        </div>

                        <h5 class="mt-2">@ex.Title</h5>
                        <p class="text-muted small">@ex.Description</p>

                        <div class="mb-2">
                            @foreach (var s in ex.Subject)
                            {
                                <span class="badge bg-light text-dark me-1">@s</span>
                            }
                        </div>

                        <div class="small text-muted d-flex justify-content-between">
                            <span>@ex.QuestionCount questions</span>
                            <span>@ex.UsageCount uses</span>
                        </div>
                    </div>
                </div>
            }
        </div>
        }

    </div>
</div>

@code {

    // Model
    public class Exercise
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public List<string> Subject { get; set; } = new();
        public List<string> Type { get; set; } = new();
        public string Difficulty { get; set; } = "";
        public DateTime LastUpdated { get; set; }
        public int QuestionCount { get; set; }
        public int UsageCount { get; set; }
        public string Visibility { get; set; } = "";
        public string Description { get; set; } = "";
    }

    // Mock data
    List<Exercise> Exercises = new()
    {
        new Exercise {
            Id="1",
            Title="Linear Equations and Inequalities",
            Subject=new(){"Math","Algebra"},
            Type=new(){"Calculation","Theory"},
            Difficulty="Medium",
            LastUpdated=new DateTime(2026,5,10),
            QuestionCount=12,
            UsageCount=24,
            Visibility="Shared with School",
            Description="Introduction to solving linear equations and systems of inequalities"
        },
        new Exercise {
            Id="2",
            Title="Newton's Laws of Motion",
            Subject=new(){"Physics","Mechanics"},
            Type=new(){"Multiple Choice","Calculation"},
            Difficulty="Hard",
            LastUpdated=new DateTime(2026,5,8),
            QuestionCount=8,
            UsageCount=15,
            Visibility="Private",
            Description="Understanding force, mass, and acceleration relationships"
        }
    };

    // State (React useState equivalents)
    string SearchQuery = "";
    string SelectedSubject = "all";
    string SelectedType = "all";
    string SelectedDifficulty = "all";
    string SelectedVisibility = "all";
    string ViewMode = "table";

    HashSet<string> SelectedExercises = new();

    // Filtering
    IEnumerable<Exercise> FilteredExercises =>
        Exercises.Where(e =>
            (string.IsNullOrWhiteSpace(SearchQuery) ||
             e.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
             e.Description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))
            &&
            (SelectedSubject == "all" || e.Subject.Contains(SelectedSubject))
            &&
            (SelectedType == "all" || e.Type.Contains(SelectedType))
            &&
            (SelectedDifficulty == "all" || e.Difficulty == SelectedDifficulty)
            &&
            (SelectedVisibility == "all" || e.Visibility == SelectedVisibility)
        );

    // Actions
    void ToggleSelect(string id)
    {
        if (!SelectedExercises.Add(id))
            SelectedExercises.Remove(id);
    }

    void ToggleSelectAll(ChangeEventArgs _)
    {
        if (SelectedExercises.Count == FilteredExercises.Count())
            SelectedExercises.Clear();
        else
            SelectedExercises = FilteredExercises.Select(e => e.Id).ToHashSet();
    }

    void ToggleView()
    {
        ViewMode = ViewMode == "table" ? "grid" : "table";
    }

    void OnCreateExercise()
    {
        Console.WriteLine("Create exercise clicked");
    }
}