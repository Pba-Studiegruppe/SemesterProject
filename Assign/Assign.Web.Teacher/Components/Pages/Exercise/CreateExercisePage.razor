@page "/create-exercise"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Web
@using Assign.Web.Teacher.Models.Exercise
@using Assign_Frontend.Services
@inject ExerciseApiClient ExerciseApi
@inject KeywordApiClient KeywordApi
@inject NavigationManager Nav

<div class="min-h-screen bg-gray-50">

    <div class="max-w-7xl mx-auto px-6 py-6">

        <div class="mb-6">

            <div class="flex items-center gap-2 text-sm text-gray-600 mb-4">

                <span class="hover:text-gray-900 cursor-pointer">
                    Dashboard
                </span>

                <i class="fas fa-chevron-right w-4 h-4"></i>

                <span class="hover:text-gray-900 cursor-pointer">
                    Exercises
                </span>

                <i class="fas fa-chevron-right w-4 h-4"></i>

                <span class="text-gray-900">
                    Create Exercise
                </span>
            </div>

            <h1 class="text-3xl">
                Create Exercise
            </h1>
        </div>

        <div class="flex gap-6">

            <!-- LEFT SIDE -->
            <div class="flex-1 space-y-6">

                <!-- Exercise Info -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-4">

                    <div>
                        <label class="block mb-2 text-sm text-gray-700">
                            Exercise Title
                        </label>

                        <input type="text"
                               value="@Form.Title"
                               @oninput="HandleExerciseTitleChanged"
                               placeholder="Enter exercise title..."
                               class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    </div>

                    <div>
                        <label class="block mb-2 text-sm text-gray-700">
                            Exercise Description
                        </label>

                        <RichTextEditor Placeholder="Describe the exercise objectives, context, and instructions..."
                                        Value="@Form.Content"
                                        ValueChanged="HandleExerciseContentChanged"
                                        MinHeight="200px" />
                    </div>

                    <div class="flex gap-3">

                        <button type="button"
                                class="inline-flex items-center gap-2 px-4 py-2 text-sm text-gray-700 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">

                            <i class="fas fa-image w-4 h-4"></i>
                            Add Image
                        </button>

                        <button type="button"
                                class="inline-flex items-center gap-2 px-4 py-2 text-sm text-gray-700 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">

                            <i class="fas fa-link w-4 h-4"></i>
                            Add Video Link
                        </button>

                        <button type="button"
                                class="inline-flex items-center gap-2 px-4 py-2 text-sm text-gray-700 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">

                            <i class="fas fa-upload w-4 h-4"></i>
                            Add File
                        </button>

                    </div>
                </div>

                <!-- Questions -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-4">

                    <div>
                        <h2 class="mb-1">
                            Questions (Optional)
                        </h2>

                        <p class="text-sm text-gray-600">
                            You can split the exercise into smaller questions.
                        </p>
                    </div>

                    <div class="space-y-3">

                        @for (int i = 0; i < Form.Questions.Count; i++)
                        {
                            var index = i;
                            var question = Form.Questions[index];

                            <QuestionCard @key="question.LocalId"
                                          QuestionNumber="@(index + 1)"
                                          @bind-Title="question.Title"
                                          @bind-Content="question.Content"
                                          @bind-Solution="question.SolutionContent"
                                          OnDuplicate="@(() => DuplicateQuestion(index))"
                                          OnDelete="@(() => DeleteQuestion(index))" />
                        }

                    </div>

                    <button type="button"
                            @onclick="AddQuestion"
                            class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 text-sm bg-blue-50 text-blue-700 border border-blue-200 rounded-lg hover:bg-blue-100 transition-colors">

                        <i class="fas fa-plus w-4 h-4"></i>
                        Add Question
                    </button>

                </div>

                <!-- Exercise Solution -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-4">

                    <div class="flex items-center justify-between">

                        <h2>
                            Exercise Solution (Optional)
                        </h2>

                        <button type="button"
                                @onclick="ToggleExerciseSolution"
                                class="text-blue-600 hover:text-blue-700 transition-colors">

                            @if (ShowExerciseSolution)
                            {
                                <i class="fas fa-chevron-down w-5 h-5"></i>
                            }
                            else
                            {
                                <i class="fas fa-plus w-5 h-5"></i>
                            }

                        </button>
                    </div>

                    @if (ShowExerciseSolution)
                    {
                        <div class="space-y-4">

                            <RichTextEditor Placeholder="Enter complete exercise solution..."
                                            Value="@Form.Solution.Content"
                                            ValueChanged="HandleExerciseSolutionChanged"
                                            MinHeight="150px" />

                            <div class="flex gap-3">

                                <button type="button"
                                        class="inline-flex items-center gap-2 px-4 py-2 text-sm text-gray-700 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">

                                    <i class="fas fa-image w-4 h-4"></i>
                                    Add Image
                                </button>

                                <button type="button"
                                        class="inline-flex items-center gap-2 px-4 py-2 text-sm text-gray-700 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">

                                    <i class="fas fa-link w-4 h-4"></i>
                                    Add Video Link
                                </button>

                            </div>

                            @* NOTE: "Students can view this solution" is a UI-only flag for now.
                               The backend's ExerciseSolution / CreateExerciseSolutionRequest does
                               not currently expose a visibility field. Wire this up once the
                               backend supports it. *@
                            <div class="flex items-center gap-3 pt-2 border-t border-gray-200">

                                <input type="checkbox"
                                       checked="@StudentsCanViewSolution"
                                       @onchange="HandleStudentsCanViewSolutionChanged"
                                       class="w-4 h-4" />

                                <span class="text-sm text-gray-700">
                                    Students can view this solution
                                </span>

                            </div>

                        </div>
                    }

                </div>

            </div>

            <!-- RIGHT SIDE -->
            <div class="w-80 space-y-4">

                <!-- Keywords -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5 space-y-4">

                    <h3>
                        Keywords
                    </h3>

                    <KeywordSelector Label="School Subject"
                                     Options="@SubjectKeywords"
                                     Placeholder="Search subjects..."
                                     SelectedIds="Form.SchoolSubjectKeywordIds"
                                     SelectedIdsChanged="@(ids => Form.SchoolSubjectKeywordIds = ids)" />

                    <KeywordSelector Label="Exercise Type"
                                     Options="@TypeKeywords"
                                     Placeholder="Search types..."
                                     SelectedIds="Form.ExerciseTypeKeywordIds"
                                     SelectedIdsChanged="@(ids => Form.ExerciseTypeKeywordIds = ids)" />

                    <KeywordSelector Label="Subject Area"
                                     Options="@AreaKeywords"
                                     Placeholder="Search areas..."
                                     SelectedIds="Form.SubjectAreaKeywordIds"
                                     SelectedIdsChanged="@(ids => Form.SubjectAreaKeywordIds = ids)" />

                </div>

                @* TODO: Exercise Settings (Difficulty / Estimated Time / Visibility) is hidden
                   until the Exercise domain entity + CreateExerciseRequest DTO expose these
                   fields. Once the backend is updated:
                     1. Add Difficulty, EstimatedTimeMinutes, Visibility to Exercise + DTOs.
                     2. Re-enable the block below.
                     3. Map them from CreateExerciseForm to CreateExerciseRequest in SubmitAsync. *@
                @*
                <!-- Settings -->
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5 space-y-4">

                    <h3>
                        Exercise Settings
                    </h3>

                    <div>

                        <label class="block mb-2 text-sm text-gray-700">
                            Difficulty
                        </label>

                        <select value="@Form.Difficulty"
                                @onchange="HandleDifficultyChanged"
                                class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">

                            <option>Easy</option>
                            <option>Medium</option>
                            <option>Hard</option>

                        </select>

                    </div>

                    <div>

                        <label class="block mb-2 text-sm text-gray-700">
                            Estimated Time (minutes)
                        </label>

                        <input type="number"
                               value="@Form.EstimatedTimeMinutes"
                               @oninput="HandleEstimatedTimeChanged"
                               placeholder="30"
                               class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />

                    </div>

                    <div>

                        <label class="block mb-2 text-sm text-gray-700">
                            Visibility
                        </label>

                        <select value="@Form.Visibility"
                                @onchange="HandleVisibilityChanged"
                                class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">

                            <option>Private</option>
                            <option>Shared with School</option>

                        </select>

                    </div>

                </div>
                *@

            </div>

        </div>

        <!-- Footer Buttons -->
        <div class="flex items-center justify-end gap-3 mt-6 pb-8">

            <button type="button"
                    @onclick="OnCancel"
                    class="px-6 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">

                Cancel
            </button>

            @* TODO: "Save Draft" is hidden because the backend only supports publishing.
               Re-enable once an endpoint / state for drafts exists on Exercise-Api. *@
            @*
            <button type="button"
                    class="px-6 py-2.5 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors">

                Save Draft
            </button>
            *@

            <button type="button"
                    @onclick="PublishExerciseAsync"
                    disabled="@IsSubmitting"
                    class="px-6 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">

                @(IsSubmitting ? "Publishing..." : "Publish Exercise")
            </button>

        </div>

    </div>

</div>

@code {

    private CreateExerciseForm Form { get; set; } = new();

    private bool ShowExerciseSolution = false;
    private bool StudentsCanViewSolution = false;
    private bool IsSubmitting = false;

    private List<KeywordDto> AllKeywords = new();
    private List<KeywordDto> SubjectKeywords = new();
    private List<KeywordDto> TypeKeywords = new();
    private List<KeywordDto> AreaKeywords = new();

    protected override async Task OnInitializedAsync()
    {
        var keywords = await KeywordApi.GetAllAsync();
        AllKeywords = keywords.ToList();

SubjectKeywords = AllKeywords.Where(k => k.KeywordType == "SchoolSubject").ToList();
TypeKeywords    = AllKeywords.Where(k => k.KeywordType == "ExerciseType").ToList();
AreaKeywords    = AllKeywords.Where(k => k.KeywordType == "SubjectArea").ToList();
    }

    private void AddQuestion()
    {
        Form.Questions.Add(new QuestionFormItem());
    }

    private void DuplicateQuestion(int index)
    {
        var src = Form.Questions[index];
        Form.Questions.Insert(index + 1, new QuestionFormItem
        {
            Title = src.Title,
            Content = src.Content,
            SolutionContent = src.SolutionContent,
            SolutionExpanded = src.SolutionExpanded,
            Expanded = true
        });
    }

    private void DeleteQuestion(int index)
    {
        Form.Questions.RemoveAt(index);
    }

    private void ToggleExerciseSolution()
    {
        ShowExerciseSolution = !ShowExerciseSolution;
    }

    private void HandleExerciseTitleChanged(ChangeEventArgs e)
    {
        Form.Title = e.Value?.ToString() ?? string.Empty;
    }

    private void HandleExerciseContentChanged(string value)
    {
        Form.Content = value;
    }

    private void HandleExerciseSolutionChanged(string value)
    {
        Form.Solution.Content = value;
    }

    private void HandleStudentsCanViewSolutionChanged(ChangeEventArgs e)
    {
        StudentsCanViewSolution = (bool)(e.Value ?? false);
    }

    private void OnCancel()
    {
        // TODO: Nav.NavigateTo("/exercises");
    }

    private async Task PublishExerciseAsync()
    {
        if (IsSubmitting) return;

        IsSubmitting = true;
        try
        {
            var request = new CreateExerciseRequest
            {
                Title = Form.Title,
                Content = Form.Content,
                // TODO: replace with the logged-in teacher's id once auth is wired up.
                CreatedByTeacherId = new Guid("00000000-0000-0000-0000-000000000001"),


                Questions = Form.Questions
                    .Select(q => (CreateQuestionRequest?)new CreateQuestionRequest
                    {
                        Title = q.Title,
                        Content = q.Content,
                        Solution = string.IsNullOrWhiteSpace(q.SolutionContent)
                            ? null
                            : new CreateQuestionSolutionRequest { Content = q.SolutionContent }
                    })
                    .ToList(),
                ExerciseKeywords = Form.SchoolSubjectKeywordIds
                    .Concat(Form.ExerciseTypeKeywordIds)
                    .Concat(Form.SubjectAreaKeywordIds)
                    .Select(id => (CreateExerciseKeywordRequest?)new CreateExerciseKeywordRequest { KeywordId = id })
                    .ToList(),
                Solution = string.IsNullOrWhiteSpace(Form.Solution.Content)
                    ? null
                    : new CreateExerciseSolutionRequest
                    {
                        Content = Form.Solution.Content,
                        VideoUrl = string.IsNullOrWhiteSpace(Form.Solution.VideoUrl) ? null : Form.Solution.VideoUrl
                    }
            };

            var created = await ExerciseApi.CreateExerciseAsync(request);
            if (created is not null) Nav.NavigateTo($"/exercises/{created.Id}");
            Console.WriteLine($"Publishing exercise: {request.Title} with {request.Questions.Count} questions");
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
