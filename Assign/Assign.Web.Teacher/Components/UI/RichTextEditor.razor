@* RichTextEditor.razor *@

<div class="border border-gray-200 rounded-lg overflow-hidden bg-white">
    <div class="flex items-center gap-1 px-3 py-2 border-b border-gray-200 bg-gray-50">

        <button type="button"
                class="p-1.5 hover:bg-gray-200 rounded transition-colors"
                title="Bold">
            <i class="fas fa-bold text-gray-600"></i>
        </button>

        <button type="button"
                class="p-1.5 hover:bg-gray-200 rounded transition-colors"
                title="Italic">
            <i class="fas fa-italic text-gray-600"></i>
        </button>

        <div class="w-px h-4 bg-gray-300 mx-1"></div>

        <button type="button"
                class="p-1.5 hover:bg-gray-200 rounded transition-colors"
                title="Bullet List">
            <i class="fas fa-list text-gray-600"></i>
        </button>

        <button type="button"
                class="p-1.5 hover:bg-gray-200 rounded transition-colors"
                title="Code Block">
            <i class="fas fa-code text-gray-600"></i>
        </button>

        <div class="w-px h-4 bg-gray-300 mx-1"></div>

        <button type="button"
                class="p-1.5 hover:bg-gray-200 rounded transition-colors"
                title="Insert Image">
            <i class="fas fa-image text-gray-600"></i>
        </button>

        <button type="button"
                class="p-1.5 hover:bg-gray-200 rounded transition-colors"
                title="Insert Link">
            <i class="fas fa-link text-gray-600"></i>
        </button>
    </div>

    <textarea value="@Content"
              @oninput="HandleChange"
              placeholder="@Placeholder"
              class="w-full px-4 py-3 resize-none focus:outline-none"
                  style="min-height:@MinHeight">
    </textarea>
    </div>

@code {

    [Parameter]
    public string Placeholder { get; set; } = "Start typing...";

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string MinHeight { get; set; } = "150px";

    private string Content = string.Empty;

    protected override void OnParametersSet()
    {
        Content = Value;
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        Content = e.Value?.ToString() ?? string.Empty;

        await ValueChanged.InvokeAsync(Content);
    }
}