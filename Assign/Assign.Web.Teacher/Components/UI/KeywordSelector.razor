@* KeywordSelector.razor *@
@using Assign.Web.Teacher.Models.Exercise

<div>
    <label class="block mb-2 text-sm text-gray-700">
        @Label
    </label>

    <div class="space-y-2">
        <div class="relative">
            <input type="text"
                   value="@InputValue"
                   @oninput="HandleInputChange"
                   @onkeydown="HandleKeyDown"
                   @onfocus="ShowSuggestions"
                   @onblur="HideSuggestions"
                   placeholder="@Placeholder"
                   class="w-full px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />

            @if (SuggestionsVisible &&
                 !string.IsNullOrWhiteSpace(InputValue) &&
                 FilteredOptions.Any())
            {
                <div class="absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-40 overflow-y-auto">

                    @foreach (var option in FilteredOptions)
                    {
                        <button type="button"
                                @onclick="() => AddKeyword(option)"
                                class="w-full text-left px-3 py-2 hover:bg-gray-50 transition-colors text-sm">

                            @option.KeywordName
                        </button>
                    }
                </div>
            }
        </div>

        @if (Selected.Any())
        {
            <div class="flex flex-wrap gap-2">
                @foreach (var keyword in Selected)
                {
                    <span class="inline-flex items-center gap-1 px-2 py-1 bg-blue-50 text-blue-700 rounded-md text-sm">
                        @keyword.KeywordName

                        <button type="button"
                                @onclick="() => RemoveKeyword(keyword)"
                                class="hover:text-blue-900">

                            <i class="fas fa-times w-3 h-3"></i>
                        </button>
                    </span>
                }
            </div>
        }
    </div>
</div>

@code {

    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public List<KeywordDto> Options { get; set; } = new();
    [Parameter] public string Placeholder { get; set; } = "Add keyword...";

    /// <summary>IDs of keywords currently selected. Two-way bindable.</summary>
    [Parameter] public List<Guid> SelectedIds { get; set; } = new();
    [Parameter] public EventCallback<List<Guid>> SelectedIdsChanged { get; set; }

    private List<KeywordDto> Selected = new();
    private string InputValue = string.Empty;
    private bool SuggestionsVisible = false;
    protected override void OnParametersSet()
    {
        // Resync Selected from SelectedIds whenever the parent changes them.
        Selected = Options
            .Where(o => SelectedIds.Contains(o.Id))
            .ToList();
    }

    private IEnumerable<KeywordDto> FilteredOptions =>
        Options.Where(option =>
            option.KeywordName.Contains(InputValue, StringComparison.OrdinalIgnoreCase)
            && !Selected.Any(s => s.Id == option.Id));

    private async Task AddKeyword(KeywordDto keyword)
    {
        if (!Selected.Any(s => s.Id == keyword.Id))
        {
            Selected.Add(keyword);
            await NotifyChanged();
        }

        InputValue = string.Empty;
        SuggestionsVisible = false;
    }

    private async Task RemoveKeyword(KeywordDto keyword)
    {
        Selected.RemoveAll(s => s.Id == keyword.Id);
        await NotifyChanged();
    }

    private Task NotifyChanged() =>
        SelectedIdsChanged.InvokeAsync(Selected.Select(s => s.Id).ToList());

    private void HandleInputChange(ChangeEventArgs e)
    {
        InputValue = e.Value?.ToString() ?? string.Empty;
        SuggestionsVisible = true;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        // Free-text "add" via Enter is disabled: keywords must exist on the
        // backend (they have a Guid Id). If you later want a "create-new-keyword"
        // flow, this is where to call KeywordApi.CreateAsync(...) then AddKeyword.
    }

    private void ShowSuggestions(FocusEventArgs e)
    {
        SuggestionsVisible = true;
    }

    private async Task HideSuggestions(FocusEventArgs e)
    {
        await Task.Delay(200);
        SuggestionsVisible = false;
        await InvokeAsync(StateHasChanged);
    }
}