@page "/"

<PageTitle>Dashboard — Assign</PageTitle>

<div style="padding: 4rem 3rem; max-width: 900px;">
    <div style="font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); font-weight: 500; margin-bottom: 0.75rem;">
        Dashboard
    </div>
    <h1 style="font-family: 'Fraunces', serif; font-weight: 500; font-size: 2.75rem; line-height: 1.1; margin: 0 0 1rem; color: var(--ink); letter-spacing: -0.02em;">
        Welcome back.
    </h1>
    <p style="font-size: 1.0625rem; color: var(--ink-2); line-height: 1.55; margin: 0 0 2.5rem; max-width: 560px;">
        This is your teacher workspace. Build exercises, organise them into assignments, and share them with your students.
    </p>

    <a href="/exercises/create" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: var(--primary); color: white; text-decoration: none; border-radius: 8px; font-weight: 500; font-size: 0.9375rem; box-shadow: 0 1px 0 rgba(255,255,255,0.15) inset, 0 6px 14px -6px rgba(27, 58, 95, 0.45);">
        Create an exercise
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
</div>
