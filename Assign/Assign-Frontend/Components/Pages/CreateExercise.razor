@page "/exercises/create"
@using Assign_Frontend.Components.Shared
@using Assign_Frontend.Components.Pages
@using Assign_Frontend.Components.Layout
@using Assign_Frontend.Models
@using Assign_Frontend.Services
@using Microsoft.AspNetCore.Components.Web
@inject ExerciseApiClient ExerciseApi
@inject KeywordApiClient KeywordApi
@inject NavigationManager Nav

<PageTitle>Create Exercise — Assign</PageTitle>

<div class="page">

    @* ── Top bar: breadcrumb + title + status ──────────────────────────── *@
    <header class="page-head">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Dashboard</a>
            <span class="crumb-sep">/</span>
            <a href="/exercises/create">Exercises</a>
            <span class="crumb-sep">/</span>
            <span class="crumb-current">Create Exercise</span>
        </nav>

        <div class="page-head-row">
            <div>
                <h1 class="page-title">Create Exercise</h1>
                <p class="page-sub">Build a self-contained exercise that you can later add to one or more assignments.</p>
            </div>
            <div class="page-status">
                @if (_saveState == SaveState.Saving)
                {
                    <span class="status-pill status-pending">
                        <span class="status-dot"></span>Saving…
                    </span>
                }
                else if (_saveState == SaveState.Saved)
                {
                    <span class="status-pill status-ok">
                        <span class="status-dot"></span>Exercise published
                    </span>
                }
                else if (_saveState == SaveState.Error)
                {
                    <span class="status-pill status-err">
                        <span class="status-dot"></span>Save failed
                    </span>
                }
            </div>
        </div>
    </header>

    @* ── Two-column layout ───────────────────────────────────────────── *@
    <div class="page-grid">

        @* ════════════════════════════════════════════════════════════════
           LEFT — EDITOR (70%)
           ════════════════════════════════════════════════════════════════ *@
        <div class="col-main">

            @* ─── Exercise Content ─── *@
            <section class="card">
                <div class="card-head">
                    <h2 class="card-title">Exercise content</h2>
                    <p class="card-sub">The main material the student will see.</p>
                </div>
                <div class="card-body">
                    <div class="field">
                        <label class="field-label" for="ex-title">Title</label>
                        <input id="ex-title"
                               type="text"
                               class="title-input"
                               placeholder="Untitled exercise"
                               @bind="_form.Title"
                               @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label class="field-label">Description</label>
                        <RichTextEditor @bind-Value="_form.Content"
                                        Size="lg"
                                        Placeholder="Lay out the context, intro, and any framing for the exercise…" />
                    </div>
                </div>
            </section>

            @* ─── Questions ─── *@
            <section class="card">
                <div class="card-head card-head-with-count">
                    <div>
                        <h2 class="card-title">
                            Questions
                            <span class="card-optional">Optional</span>
                        </h2>
                        <p class="card-sub">
                            You can split the exercise into smaller questions. These can later be enabled or disabled when adding the exercise to an assignment.
                        </p>
                    </div>
                    <div class="qcount">@_form.Questions.Count</div>
                </div>

                <div class="card-body">
                    @if (_form.Questions.Count == 0)
                    {
                        <div class="empty">
                            <div class="empty-mark"></div>
                            <div class="empty-title">No questions yet</div>
                            <div class="empty-body">Add a question to split this exercise into parts. Skip this if it's a single open-ended task.</div>
                        </div>
                    }
                    else
                    {
                        <div class="qlist">
                            @for (var i = 0; i < _form.Questions.Count; i++)
                            {
                                var idx = i;
                                var q = _form.Questions[i];
                                <QuestionCard Question="q"
                                              Index="idx"
                                              OnDuplicateRequested="DuplicateQuestion"
                                              OnDeleteRequested="DeleteQuestion"
                                              @key="q.LocalId" />
                            }
                        </div>
                    }

                    <button type="button" class="add-btn" @onclick="AddQuestion">
                        <span class="add-btn-plus">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        </span>
                        Add question
                    </button>
                </div>
            </section>

            @* ─── Exercise Solution ─── *@
            <section class="card card-gold">
                <div class="card-head">
                    <h2 class="card-title">
                        Exercise solution
                        <span class="card-optional">Optional</span>
                    </h2>
                    <p class="card-sub">
                        The overall answer or worked solution for the exercise as a whole. Hidden from students until the teacher releases it.
                    </p>
                </div>
                <div class="card-body">
                    <div class="field">
                        <label class="field-label">Solution content</label>
                        <RichTextEditor @bind-Value="_form.Solution.Content"
                                        Placeholder="The intended solution, worked steps, or answer key…" />
                    </div>
                    <div class="field">
                        <label class="field-label" for="ex-video">Video URL <span class="field-label-aux">optional</span></label>
                        <input id="ex-video"
                               type="url"
                               class="plain-input"
                               placeholder="https://…"
                               @bind="_form.Solution.VideoUrl" />
                    </div>
                </div>
            </section>
        </div>

        @* ════════════════════════════════════════════════════════════════
           RIGHT — METADATA SIDEBAR (30%)
           ════════════════════════════════════════════════════════════════ *@
        <aside class="col-side">

            @* ─── Keywords ─── *@
            <section class="card">
                <div class="card-head">
                    <h2 class="card-title small-title">Keywords</h2>
                    <p class="card-sub">Help other teachers and students find this exercise.</p>
                </div>
                <div class="card-body card-body-tight">
                    @if (_loadingKeywords)
                    {
                        <div class="skel"></div>
                        <div class="skel"></div>
                        <div class="skel"></div>
                    }
                    else
                    {
                        <KeywordSelector Label="School subject"
                                         Description="E.g. Math, Physics, Chemistry."
                                         Available="_schoolSubjectKeywords"
                                         @bind-SelectedIds="_form.SchoolSubjectKeywordIds" />

                        <div class="kw-divider"></div>

                        <KeywordSelector Label="Exercise type"
                                         Description="E.g. Multiple choice, theory, calculation."
                                         Available="_exerciseTypeKeywords"
                                         @bind-SelectedIds="_form.ExerciseTypeKeywordIds" />

                        <div class="kw-divider"></div>

                        <KeywordSelector Label="Subject area"
                                         Description="E.g. Algebra, Thermodynamics, Geometry."
                                         Available="_subjectAreaKeywords"
                                         @bind-SelectedIds="_form.SubjectAreaKeywordIds" />
                    }
                </div>
            </section>

            @* ─── Settings ─── *@
            @* TODO: These settings are not yet reflected on the Exercise
               domain entity / API. They render here for layout completeness
               and are NOT sent in CreateExerciseRequest. Wire them up once
               the backend exposes the corresponding properties. *@
            <section class="card card-future">
                <div class="card-head">
                    <h2 class="card-title small-title">Exercise settings</h2>
                    <p class="card-sub">
                        <span class="badge-future">UI only</span>
                        Not yet persisted — backend properties to follow.
                    </p>
                </div>
                <div class="card-body card-body-tight">

                    <div class="setting">
                        <div class="setting-label">Difficulty</div>
                        <select class="plain-select" @bind="_form.Difficulty">
                            <option value="">Choose…</option>
                            <option value="Easy">Easy</option>
                            <option value="Medium">Medium</option>
                            <option value="Hard">Hard</option>
                        </select>
                    </div>

                    <div class="setting">
                        <div class="setting-label">Estimated time</div>
                        <div class="time-input">
                            <input type="number"
                                   min="0"
                                   class="plain-input"
                                   placeholder="—"
                                   @bind="_form.EstimatedTimeMinutes" />
                            <span class="time-unit">min</span>
                        </div>
                    </div>

                    <div class="setting">
                        <div class="setting-label">Visibility</div>
                        <div class="seg">
                            <button type="button"
                                    class="seg-btn @(_form.Visibility == "Private" ? "seg-btn-active" : "")"
                                    @onclick='() => _form.Visibility = "Private"'>
                                Private
                            </button>
                            <button type="button"
                                    class="seg-btn @(_form.Visibility == "Shared" ? "seg-btn-active" : "")"
                                    @onclick='() => _form.Visibility = "Shared"'>
                                Shared with school
                            </button>
                        </div>
                    </div>
                </div>
            </section>
        </aside>
    </div>

    @* ── Action bar ───────────────────────────────────────────────────── *@
    <div class="action-bar">
        <div class="action-bar-inner">
            <div class="action-bar-info">
                @if (_errorMessage is not null)
                {
                    <div class="action-error">@_errorMessage</div>
                }
                else if (!CanSave)
                {
                    <div class="action-hint">Add a title to enable publishing.</div>
                }
                else
                {
                    <div class="action-hint">Ready when you are.</div>
                }
            </div>
            <div class="action-bar-buttons">
                <button type="button" class="btn btn-ghost" @onclick="Cancel" disabled="@(_saveState == SaveState.Saving)">
                    Cancel
                </button>
                @* TODO: Once Exercise supports a draft/published lifecycle
                   (e.g. an `IsPublished` flag), split this into two buttons:
                   "Save draft" (secondary) and "Publish exercise" (primary). *@
                <button type="button"
                        class="btn btn-primary"
                        @onclick="Save"
                        disabled="@(_saveState == SaveState.Saving || !CanSave)">
                    @if (_saveState == SaveState.Saving)
                    {
                        <span class="spinner"></span>
                        <span>Publishing…</span>
                    }
                    else
                    {
                        <span>Save & publish exercise</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateExerciseForm _form = new();

    private IReadOnlyList<KeywordDto> _schoolSubjectKeywords = Array.Empty<KeywordDto>();
    private IReadOnlyList<KeywordDto> _exerciseTypeKeywords  = Array.Empty<KeywordDto>();
    private IReadOnlyList<KeywordDto> _subjectAreaKeywords   = Array.Empty<KeywordDto>();
    private bool _loadingKeywords = true;

    private SaveState _saveState = SaveState.Idle;
    private string? _errorMessage;

    // TODO: Replace this with the actual authenticated teacher's id once
    // authentication is wired into the frontend. For now, a placeholder so
    // the API receives a valid Guid.
    private static readonly Guid PlaceholderTeacherId =
        new("00000000-0000-0000-0000-000000000001");

    private enum SaveState { Idle, Saving, Saved, Error }

    private bool CanSave => !string.IsNullOrWhiteSpace(_form.Title);

    protected override async Task OnInitializedAsync()
    {
        await LoadKeywords();
    }

    private async Task LoadKeywords()
    {
        _loadingKeywords = true;
        var all = await KeywordApi.GetAllAsync();

        // The KeywordType strings below must match the values exposed by the
        // Exercise-Domain.Entities.KeywordType enum (serialized as strings).
        // Adjust here if the enum members are named differently.
        _schoolSubjectKeywords = all.Where(k => MatchesType(k, "SchoolSubject", "School", "Subject")).ToList();
        _exerciseTypeKeywords  = all.Where(k => MatchesType(k, "ExerciseType", "Type")).ToList();
        _subjectAreaKeywords   = all.Where(k => MatchesType(k, "SubjectArea", "Area")).ToList();

        _loadingKeywords = false;
    }

    private static bool MatchesType(KeywordDto k, params string[] candidates) =>
        candidates.Any(c => string.Equals(k.KeywordType, c, StringComparison.OrdinalIgnoreCase));

    // ── Question handlers ────────────────────────────────────────────────

    private void AddQuestion()
    {
        // Collapse the others so the new one is the focus.
        foreach (var existing in _form.Questions) existing.Expanded = false;
        _form.Questions.Add(new QuestionFormItem { Expanded = true });
    }

    private void DuplicateQuestion(QuestionFormItem source)
    {
        var copy = new QuestionFormItem
        {
            Title = source.Title,
            Content = source.Content,
            SolutionContent = source.SolutionContent,
            SolutionExpanded = source.SolutionExpanded,
            Expanded = true
        };
        var idx = _form.Questions.IndexOf(source);
        _form.Questions.Insert(idx + 1, copy);
    }

    private void DeleteQuestion(QuestionFormItem q)
    {
        _form.Questions.Remove(q);
    }

    // ── Save ─────────────────────────────────────────────────────────────

    private async Task Save()
    {
        if (!CanSave) return;

        _saveState = SaveState.Saving;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var request = BuildRequest();
            var created = await ExerciseApi.CreateExerciseAsync(request);
            _saveState = SaveState.Saved;

            // Small pause so the user sees the success state, then reset.
            await Task.Delay(900);
            _form = new CreateExerciseForm();
            _saveState = SaveState.Idle;
        }
        catch (Exception ex)
        {
            _saveState = SaveState.Error;
            _errorMessage = ex.Message;
        }
    }

    private CreateExerciseRequest BuildRequest()
    {
        var keywords = _form.SchoolSubjectKeywordIds
            .Concat(_form.ExerciseTypeKeywordIds)
            .Concat(_form.SubjectAreaKeywordIds)
            .Select(id => new CreateExerciseKeywordRequest { KeywordId = id })
            .Cast<CreateExerciseKeywordRequest?>()
            .ToList();

        var questions = _form.Questions
            .Select(q => new CreateQuestionRequest
            {
                Title = q.Title,
                Content = q.Content,
                Solution = string.IsNullOrWhiteSpace(q.SolutionContent)
                    ? null
                    : new CreateQuestionSolutionRequest { Content = q.SolutionContent }
            })
            .Cast<CreateQuestionRequest?>()
            .ToList();

        CreateExerciseSolutionRequest? solution = null;
        var hasSolutionContent = !string.IsNullOrWhiteSpace(_form.Solution.Content);
        var hasSolutionVideo = !string.IsNullOrWhiteSpace(_form.Solution.VideoUrl);
        if (hasSolutionContent || hasSolutionVideo)
        {
            solution = new CreateExerciseSolutionRequest
            {
                Content = _form.Solution.Content,
                VideoUrl = string.IsNullOrWhiteSpace(_form.Solution.VideoUrl) ? null : _form.Solution.VideoUrl
            };
        }

        return new CreateExerciseRequest
        {
            Title = _form.Title,
            Content = _form.Content,
            CreatedByTeacherId = PlaceholderTeacherId,
            Questions = questions,
            ExerciseKeywords = keywords,
            Solution = solution
        };
    }

    private void Cancel()
    {
        Nav.NavigateTo("/");
    }
}
